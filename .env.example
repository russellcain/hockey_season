# Copy to .env and fill in values before running docker compose up.
# .env is gitignored — never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens for draft sessions.
# Generate one with: openssl rand -hex 32
DRAFT_SECRET=change-me-to-a-random-secret

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the frontend nginx container binds to on the host.
# If you're putting Caddy/Traefik in front, point that proxy to this port.
# Default: 3000
# FRONTEND_PORT=3000
